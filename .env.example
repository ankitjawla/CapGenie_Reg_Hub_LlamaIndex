# Copy to .env and fill in values. Do not commit .env.

# Required — LlamaCloud (LlamaParse + LlamaExtract)
LLAMA_API_KEY=

# Optional — LlamaExtract model slug (overrides deployment fallback)
# Examples: openai-gpt-4-1, or your LlamaCloud-allowed model name
LLAMA_EXTRACT_MODEL=

# Optional — Azure OpenAI used for extract_model fallback and optional LlamaParse routing
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Alternate key name supported by the app:
# AZURE_OPENAI_KEY=

AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Optional — pipeline tuning (defaults shown)
# FRY9C_PARSE_FAST_MODE=true
# FRY9C_SPLIT_MODE=hybrid
# FRY9C_SPLIT_MODE=footer_only
