# Copy to .env and fill in values. Do not commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# LlamaCloud API key — used for both LlamaParse and LlamaExtract.
# New SDK name: LLAMA_CLOUD_API_KEY  (also accepted: LLAMA_API_KEY, LLAMA_PARSE_API_KEY)
LLAMA_CLOUD_API_KEY=
# Legacy alias (supported as fallback in this app):
# LLAMA_API_KEY=

# ── LlamaExtract model ───────────────────────────────────────────────────────
# Must be a valid LlamaCloud model slug — NOT an Azure deployment name.
# Setting this activates PREMIUM mode automatically.
# Valid options: openai-gpt-4-1 (default) | openai-gpt-5-mini | openai-gpt-5
# Leave blank to use MULTIMODAL mode with the LlamaCloud default parse model.
LLAMA_EXTRACT_MODEL=openai-gpt-4-1

# ── Extraction mode ──────────────────────────────────────────────────────────
# BALANCED (default when unset) — recommended starting point for FRY9C tables.
# MULTIMODAL / PREMIUM / FAST — see LlamaCloud docs for tradeoffs.
# LLAMA_EXTRACT_MODE=BALANCED

# ── Extraction reasoning (optional) ───────────────────────────────────────────
# true (default) / false — maps to LlamaExtract use_reasoning
# LLAMA_EXTRACT_USE_REASONING=true

# ── Azure OpenAI (optional — for direct Azure OpenAI usage, NOT LlamaCloud extraction) ──
# These credentials are used for Azure OpenAI calls OUTSIDE of LlamaExtract.
# LlamaCloud extraction uses its own model routing via LLAMA_EXTRACT_MODEL above.
# Azure deployment names (e.g. "gpt-5.4") are NOT valid LlamaCloud model slugs.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ── Parse tier ───────────────────────────────────────────────────────────────
# fast (default)    — lower cost; usually enough for footer/header split cues
# cost_effective    — middle tier
# agentic           — highest accuracy for difficult PDFs
# FRY9C_PARSE_TIER=fast

# ── Split mode ────────────────────────────────────────────────────────────────
# hybrid      (default) — header in first ~600 chars, then footer codes
# footer_only           — package-style footer patterns only
# FRY9C_SPLIT_MODE=hybrid

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# How many days before a local cache entry is considered stale (0 = no TTL).
# CACHE_MAX_AGE_DAYS=7
