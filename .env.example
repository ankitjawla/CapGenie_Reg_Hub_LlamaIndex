# Copy to .env and fill in values. Do not commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# LlamaCloud API key — used for both LlamaParse and LlamaExtract.
# New SDK name: LLAMA_CLOUD_API_KEY  (also accepted: LLAMA_API_KEY, LLAMA_PARSE_API_KEY)
LLAMA_CLOUD_API_KEY=
# Legacy alias (supported as fallback in this app):
# LLAMA_API_KEY=

# ── LlamaExtract model ───────────────────────────────────────────────────────
# Explicit extract model slug. Only effective when LLAMA_EXTRACT_MODE=PREMIUM.
# Available PREMIUM extract models: openai-gpt-4-1, openai-gpt-5-mini, openai-gpt-5
# Leave blank to use the PREMIUM default (openai-gpt-4-1).
LLAMA_EXTRACT_MODEL=

# ── Extraction mode ──────────────────────────────────────────────────────────
# MULTIMODAL (default) — best for visually rich documents, configurable parse model.
# PREMIUM             — best for complex tables; supports configurable extract model.
# BALANCED            — good balance, no model overrides.
# FAST                — OCR only, no AI parsing.
# LLAMA_EXTRACT_MODE=PREMIUM

# ── Azure OpenAI (optional) ──────────────────────────────────────────────────
# Used as extract_model fallback when LLAMA_EXTRACT_MODEL is unset.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ── Parse tier ───────────────────────────────────────────────────────────────
# agentic (default) — best accuracy for complex PDFs
# cost_effective    — cheaper, slightly less accurate
# fast              — OCR only, no LLM
# FRY9C_PARSE_TIER=agentic

# ── Split mode ────────────────────────────────────────────────────────────────
# hybrid      (default) — header in first ~600 chars, then footer codes
# footer_only           — package-style footer patterns only
# FRY9C_SPLIT_MODE=hybrid

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# How many days before a local cache entry is considered stale (0 = no TTL).
# CACHE_MAX_AGE_DAYS=7
